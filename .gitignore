# ============================================================
# LP-PC Suite — .gitignore
# ============================================================
# Rule: anchor top-level dirs with leading "/" to avoid
#       accidentally ignoring same-named dirs at deeper levels.
# Rule: whitelist must follow its own ignore rule.
# ============================================================

# ==================== PYTHON ====================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
/build/
/dist/

# ==================== VIRTUAL ENV ====================
.venv/
venv/
ENV/
env/
.venv.bak/
pythonenv*

# ==================== TEST / COVERAGE ====================
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
*.lcov
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.black-cache/

# ==================== RUNTIME WORKSPACE ====================
# Ignore toàn bộ — git không track empty dirs nên không cần .gitkeep.
workspace/

# Legacy paths
src/workspace/
src/src/workspace/

# ==================== LOGS ====================
logs/
*.log
*_log.txt
e2e*.txt
e2e*.log
!logs/.gitkeep

# ==================== TOOLS — LARGE BINARIES ====================
# JARs ~5-30MB → download via tools/scripts/setup.ps1
tools/bin/*.jar
tools/*.jar
tools/*.zip
tools/*.z01
tools/*.z02
tools/*.z03
tools/_bundletool_combined.zip

# GDA (large Windows binary)
tools/GDA.exe
tools/GDA/
tools/bin/GDA/

# Keep tool scripts (setup + audit + e2e)
!tools/scripts/
!tools/scripts/*.py
!tools/scripts/*.ps1

# Keep README + reorganize helper
!tools/README.md
!tools/reorganize.py

# Proxy smali (small, tracked as source)
!tools/proxy_service/smali/**/*.smali

# ==================== KEYS ====================
tools/keys/*
!tools/keys/.gitkeep
!tools/keys/README.md
!tools/keys/testkey.pk8
!tools/keys/testkey.x509.pem
!tools/keys/platform.pk8
!tools/keys/platform.x509.pem
!tools/keys/media.pk8
!tools/keys/media.x509.pem
!tools/keys/shared.pk8
!tools/keys/shared.x509.pem

# Production keys — NEVER commit
tools/keys/production_*
tools/keys/*.keystore
tools/keys/*.jks
tools/keys/*.p12

# ==================== APK SAMPLES ====================
# Root-level test samples (ZT.apk, etc.)
/ZT.apk
/sample.apk
/*.apk
/*.xapk
/*.apks
/*.aab

# Everywhere else (exclude fixtures)
*.apk
*.xapk
*.apks
*.aab
!src/tests/fixtures/*.apk
!src/tests/fixtures/*.xapk

# ==================== CUSTOM PATCHES / PLUGINS ====================
patches/*
!patches/.gitkeep

plugins/*
!plugins/__init__.py
!plugins/.gitkeep

# ==================== USER CONFIG ====================
config/user.yaml
config/local.yaml
config/*.local.yaml
!config/default.yaml

# ==================== SECRETS ====================
.env
.env.*
!.env.example
*.secret
secrets.json
credentials.json
!credentials.json.example

# ==================== IDE / EDITOR ====================
.vscode/
!.vscode/settings.json.example
!.vscode/launch.json.example
!.vscode/extensions.json.example

.idea/
*.iml
*.iws
*.ipr

*.swp
*.swo
*~
\#*\#
.\#*
*.sublime-workspace
*.sublime-project
.ipynb_checkpoints/

# ==================== OS ====================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==================== TEMP / BACKUP ====================
*.tmp
*.temp
*.bak
*.orig
*.rej
/tmp/
/temp/
/.tmp/
/.temp/

# ==================== PROJECT-SPECIFIC CACHE ====================
# Signed/patched outputs accidentally left in root
*_signed.apk
*_patched.apk
*-aligned-debugSigned.apk
*-aligned.apk
cloned.apk
merged.apk
patched.apk

# History backups
patch_history.json.bak
patch_history.json.old

# Metrics exports
metrics.csv
metrics_export.json

# Debug dumps
debug_dump_*.txt
debug_dump_*.json
crash_dump_*.txt

# ==================== DOCS BUILD ====================
docs/_build/
docs/build/
site/

# ==================== CI (local overrides) ====================
.github/workflows/*.local.yml

# ============================================================
# KEEP COMMITTED (do NOT ignore):
#   pyproject.toml, uv.lock, requirements.txt (if kept)
#   Makefile, pytest.ini (if kept), .gitignore, README.md
#   src/**, tools/scripts/**, config/default.yaml, assets/**
# ============================================================